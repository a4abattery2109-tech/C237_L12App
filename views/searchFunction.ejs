<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Japanese Learning</title>
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="container mt-3">
        <h2>Search Japanese Items</h2>

        <form class="row g-3 mb-4" action="/search" method="GET">
            <div class="col-auto flex-grow-1">
              <input type="text" name="level" class="form-control" placeholder="Search by level" value="<%= searchQuery %>">
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </form>

        <% if (searchQuery) { %>
            <h5>Results for "<%= searchQuery %>"</h5>
            <% if (results.length > 0) { %>
                <table class="table table-striped mt-3">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Type</th>
                            <th>Level</th>
                            <th>Japanese</th>
                            <th>Meaning</th>
                            <th>Edit</th>
                            <th>Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% results.forEach(function(item, index) { %>
                            <tr>
                                <td><%= item.id %></td>
                                <td><%= item.type %></td>
                                <td><%= item.level %></td>
                                <td><%= item.japanese %></td>
                                <td><%= item.meaning %></td>
                                <td><a href="/items/<%= item.id %>/update" class="btn btn-primary btn-sm">Edit</a></td>
                                <td><a href="/items/<%= item.id %>/delete" class="btn btn-danger btn-sm">Delete</a></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } else { %>
                <!-- If no results match, show an informative message -->
                <div class="alert alert-warning">No items found for "<%= searchQuery %>".</div>
            <% } %>
        <% } else { %>
            <!-- No search query entered yet: prompt the user to search -->
            <div class="alert alert-secondary">Enter a search term above to find Japanese items.</div>
        <% } %>
    </div>
</body>
</html>
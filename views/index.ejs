<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Japanese Learning</title>
</head>
<body>
 <%- include('partials/navbar') %>
    <h2>Japanese Learning</h2>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Type</th>
                <th>Level</th>
                <th>Japanese</th>
                <th>Meaning</th>
                <th>Edit</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            <% for (let i = 0; i < items.length; i++) { %>
                <tr>
                    <td><%= items[i].id %></td>
                    <td><%= items[i].type %></td>
                    <td><%= items[i].level %></td>
                    <td><a href="/items/<%= items[i].id %>" class="text-decoration-none"><%= items[i].japanese %></a></td>
                    <td><%= items[i].meaning %></td>
                    <td><a href="/items/<%= items[i].id %>/update" class="btn btn-primary">Edit</a></td>
                    <td><a href="/items/<%= items[i].id %>/delete" class="btn btn-danger">Delete</a></td>
                </tr>
            <% } %>
        </tbody>
    </table>
</body>
</html>
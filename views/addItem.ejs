<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Japanese Learning</title>
</head>
<body>
    <%- include ('partials/navbar.ejs') %>
    <div class="container mt-3">
        <h2>Add a new item</h2>

        <form action="/items" method="POST">
            <div class="mb-3 mt-3">
                <label for="type">Type:</label>
                <input type="text" class="form-control" id="type" placeholder="Enter type" name="type">
            </div>
            <div class="mb-3 mt-3">
                <label for="level">Level:</label>
                <input type="text" class="form-control" id="level" placeholder="Enter level" name="level">
            </div>
            <div class="mb-3 mt-3">
                <label for="japanese">Japanese:</label>
                <input type="text" class="form-control" id="japanese" placeholder="Enter Japanese word/phrase" name="japanese">
            </div>
            <div class="mb-3 mt-3">
                <label for="pronunciation">Pronunciation:</label>
                <input type="text" class="form-control" id="pronunciation" placeholder="Enter pronunciation" name="pronunciation">
            </div>
            <div class="mb-3 mt-3">
                <label for="meaning">Meaning:</label>
                <input type="text" class="form-control" id="meaning" placeholder="Enter meaning" name="meaning">
            </div>
            <div class="mb-3 mt-3">
                <label for="example">Example:</label>
                <input type="text" class="form-control" id="example" placeholder="Enter example sentence" name="example">
            </div>
            <button type="submit" class="btn btn-primary">Submit</button>
        </form>
    </div>
</body>
</html>